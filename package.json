{
  "name": "dsh-plugin-mimo-delegate",
  "version": "0.1.2",
  "description": "DeepSeek Harness plugin: a sidebar switch plus settings card that turns the local Xiaomi MiMo Desktop delegation pipeline (the mimo-delegate skill) on and off.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "preflight.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preflight": "node preflight.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node preflight.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "mimo",
    "delegation",
    "sidebar"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "license": "MIT"
}
